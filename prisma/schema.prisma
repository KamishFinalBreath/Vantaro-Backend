// Prisma schema for Vantaro (Supabase Postgres backend)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
  FAILED
}

enum PrintifyOrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
}

model User {
  // id is the Supabase Auth user id (auth.users.id / JWT `sub` claim).
  id           String   @id
  email        String?
  firstName    String?
  lastName     String?
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders       Order[]
}

model Product {
  id                String   @id @default(cuid())
  printifyProductId String   @unique
  title             String
  description       String?
  tags              String[] @default([])
  thumbnailUrl      String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  variants          ProductVariant[]
  orderItems        OrderItem[]

  @@index([isActive])
}

model ProductVariant {
  id                    String  @id @default(cuid())
  productId             String
  printifyVariantId     String
  title                 String
  sku                   String?
  priceCents            Int
  currency              String  @default("usd")
  isAvailable           Boolean @default(true)
  printifyVariantData   Json?

  product               Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems            OrderItem[]

  @@unique([productId, printifyVariantId])
  @@index([productId])
}

model Order {
  id                    String             @id @default(cuid())
  userId                String
  status                OrderStatus        @default(PENDING)
  printifyOrderStatus   PrintifyOrderStatus @default(PENDING)

  // Money is stored in the smallest currency unit (cents).
  totalCents            Int
  currency              String             @default("usd")

  // Stripe
  stripeCheckoutId      String?            @unique
  stripePaymentIntentId String?            @unique

  // Printify
  printifyOrderId       String?            @unique

  // Shipping details captured at checkout, used to create the Printify order.
  shippingAddress       Json?

  // Idempotency: a unique key per checkout attempt prevents duplicate orders.
  idempotencyKey        String             @unique

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  user                  User               @relation(fields: [userId], references: [id])
  items                 OrderItem[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String
  productId         String
  variantId         String
  printifyVariantId String
  title             String
  sku               String?
  quantity          Int
  unitPriceCents    Int
  currency          String  @default("usd")

  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product @relation(fields: [productId], references: [id])
  variant           ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}