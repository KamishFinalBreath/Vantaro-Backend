# ---- Runtime ----
NODE_ENV=development
PORT=4000

# Public base URL of the storefront, used for Stripe success/cancel redirects.
PUBLIC_BASE_URL=http://localhost:3000

# ---- Supabase (Auth + Postgres via Prisma) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Prisma connection string (use the Supabase connection pooler URL in production).
DATABASE_URL=postgresql://postgres:password@localhost:5432/vantaro?schema=public

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ---- Printify ----
PRINTIFY_API_KEY=your_printify_api_key
PRINTIFY_SHOP_ID=your_printify_shop_id
PRINTIFY_SHIPPING_METHOD=1
# Optional shared secret configured on the Printify webhook endpoint.
PRINTIFY_WEBHOOK_SECRET=